.venv/
__pycache__/
*.pyc

# Runtime IPC scratch files (overwritten every frame by the Lua bridge)
action.txt
state.txt
action[0-9]*.txt
state[0-9]*.txt
frames/*.png

# RL training outputs
# Note "models/*" and not "models/": git does not descend into an excluded
# DIRECTORY, so a negation inside one never matches.
models/*
# ...except the track map. It is small (under 2KB) and NOT reproducible from
# the repo alone: rebuilding it needs a human-driven lap recorded through
# lua/ram_record.lua. Without it the bridge cannot report progress at all.
!models/track_mute_city.npz
logs/
*.zip

# RAM capture artifacts (large binaries)
ram_capture.bin
ram_capture.csv
bridge_error*.txt
*.tmp
runs/*.csv
runs/frames/
action*.tmp
ram_heading*.bin
ram_abc*.bin
ram_verify*.bin
ram_confirm*.bin
ram_race*.bin
ram_race*.csv
ram_death*.bin
ram_death*.csv
ram_boot*.bin
ram_boot*.csv
vision/fixtures/unsorted/
vision/fixtures/race_state/
runs/store/

# Transient per-process lock records; PIDs from whoever ran training last.
runs/locks/
runs/*.log

# Local credentials and emulator assets
.env
.env.*
!.env.example
/.aws/
*.sfc
*.smc
*.state
*.bk2
*.SaveRAM
/roms/
/BizHawk*/
.pytest_cache/
